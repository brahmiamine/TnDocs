NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=mysql://tndocs:tndocs_dev_only@127.0.0.1:3306/tndocs
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=dev_only_change_before_deployment
STORAGE_ROOT=./.data/storage
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TnDocs <no-reply@example.test>
PASSWORD_PEPPER=replace_with_a_long_random_secret
PROFILE_ENCRYPTION_KEY_V1=replace_with_a_random_32_byte_base64_key
DOCUMENT_ENCRYPTION_KEY_V1=replace_with_a_separate_random_32_byte_base64_key
ATTACHMENT_ENCRYPTION_KEY_V1=replace_with_a_separate_random_32_byte_base64_key
# Advanced identity (independent 32-byte Base64 key)
IDENTITY_ENCRYPTION_KEY_V1=replace_with_a_separate_random_32_byte_base64_key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PDF renderer; Chromium and licensed Noto fonts are provided by the worker image
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
RENDER_CHROMIUM_NO_SANDBOX=false
# Optional source collection: exact approved HTTPS hosts, disabled when empty
SOURCE_ALLOWED_HOSTS=
# Optional opt-in Web Push (generate VAPID keys locally)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Operational safety budgets (configurable before enabling uploads/exports)
ACCOUNT_STORAGE_QUOTA_BYTES=104857600
DOSSIER_EXPORT_MAX_BYTES=104857600
DOSSIER_EXPORT_MAX_PAGES=200
EXPORT_ARTIFACT_TTL_HOURS=24
# Independent backup encryption; never store this key with an encrypted archive
BACKUP_ENCRYPTION_KEY=replace_with_a_separate_random_32_byte_base64_key
# Optional JSON argv command; invoked only with backup --upload after provider selection
BACKUP_OFFSITE_COMMAND=
