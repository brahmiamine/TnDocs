{
  "name": "tndocs",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme bilingue de documents et démarches tunisiennes",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "admin:promote": "node scripts/promote-admin.mjs",
    "test": "node scripts/test.mjs",
    "worker": "tsx scripts/worker.ts",
    "test:integration": "node scripts/test.mjs --integration",
    "backup": "tsx scripts/backup.ts",
    "backup:restore": "tsx scripts/restore-backup.ts"
  },
  "dependencies": {
    "docx": "^9.15.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.44.7",
    "fflate": "^0.8.3",
    "mysql2": "^3.15.3",
    "next": "^15.5.6",
    "nodemailer": "^10.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "puppeteer-core": "^25.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.14.0",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.12",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
